;= generated by scripts/build-cmd-macros.py from windows/topics/*.ps1, do not edit by hand
;= loaded by autorun.cmd with doskey /macrofile
;= 03-navigation.ps1
dev=cd /d "%USERPROFILE%\dev"
downloads=cd /d "%USERPROFILE%\Downloads"
;= 04-git.ps1
gs=git status
ga=git add $*
gaa=git add --all
gcmt=git commit -m $*
gpsh=git push $*
gpul=git pull
glog=git log --oneline --graph --decorate --all
gco=git checkout $*
gb=git branch $*
gd=git diff
gclean=git clean -fd
gundo=git reset HEAD~1
gmain=git checkout main $T git pull --ff-only
gprune=git fetch --prune $T git remote prune origin
automerge=gh pr merge --squash --delete-branch --auto $*
;= 07-utilities.ps1
serve=python -m http.server 8080
regex101=start "" "https://regex101.com"
;= 09-cli-tools.ps1
ez=eza $*
ezl=eza -lah --git $*
ezt=eza --tree --level=2 $*
rg2=rg $*
;= 10-ssh.ps1
sshls=ssh-add -l
sshconf=code "%USERPROFILE%\.ssh\config"
node1=ssh node1
node2=ssh node2
node3=ssh node3
node4=ssh node4
scpto=scp $1 $2
scpfrom=scp $1 .
;= 11-network.ps1
ping4=ping -n 4 $1
flushdns=ipconfig /flushdns
nginx-test=nginx -t
nginx-reload=nginx -s reload
;= 12-security.ps1
gpgls=gpg --list-keys
gpglss=gpg --list-secret-keys
gpgenc=gpg --encrypt --armor -r $2 $1
gpgdec=gpg --decrypt $1
gpgsign=gpg --detach-sign --armor $1
gpgverify=gpg --verify $1 $2
gpgexport=gpg --export --armor $1
gpgimport=gpg --import $1
wh=whois $1
msfq=wsl msfconsole -q
;= 13-database.ps1
pgls=psql -l
pgdump=pg_dump $*
pgrestore=pg_restore $*
pgusers=psql -c "\du"
pgsize=psql -c "\l+"
myls=mysql -e "SHOW DATABASES;"
mydump=mysqldump $*
sq=sqlite3 $1
sqnew=sqlite3 $1
sqls=sqlite3 $1 ".tables"
sqschema=sqlite3 $1 ".schema"
rcli=redis-cli $*
rping=redis-cli ping
rflush=redis-cli FLUSHALL
rmon=redis-cli MONITOR
rkeys=redis-cli KEYS "*"
rinfo=redis-cli INFO
rsize=redis-cli DBSIZE
rdel=redis-cli DEL $1
mconn=mongosh $*
mdump=mongodump --db $1
mrestoredb=mongorestore --db $1 $2
influx=influx.exe $*
;= 15-rsync.ps1
rls=rclone ls $*
rclonecopy=rclone copy --progress $*
rclonesync=rclone sync --progress $*
rcloneremotes=rclone listremotes
rclonemove=rclone move --progress $*
rclonesize=rclone size $*
;= 16-winget.ps1
wgup=winget upgrade --all
wgls=winget list
chocoins=choco install $1 -y
chocolist=choco list --local-only
chocoup=choco upgrade all -y
chocoinfo=choco info $1
;= 17-gh.ps1
ghprl=gh pr list
